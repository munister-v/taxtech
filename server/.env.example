# Kopiyka Sandbox Bank — приклад конфігурації. Скопіюйте в .env і за потреби змініть.
# УВАГА: це навчальна пісочниця. Усі гроші — токени TAX, не справжні.

# ── База даних ───────────────────────────────────────────────────────────────
# Порожньо = SQLite у database/kopiyka_sandbox.db (за замовчуванням).
DATABASE_URL=
# Приклад для локального PostgreSQL:
# DATABASE_URL=postgresql://localhost:5432/kopiyka_sandbox
# Інший шлях до SQLite-файлу (необов'язково):
# KOPIYKA_DATABASE_PATH=/abs/path/kopiyka.db

# ── Сервер ───────────────────────────────────────────────────────────────────
# Секрет для токенів сесій (згенеруйте свій: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-sandbox-secret
# HOST=0.0.0.0 — щоб фізичний iPhone у тій самій Wi-Fi мережі бачив сервер
HOST=127.0.0.1
PORT=5050
DEBUG=1
TOKEN_TTL_HOURS=720
# Якщо сервер стоїть за проксі з префіксом:
# BASE_PATH=/kopiyka
# Лише для браузерних клієнтів (iOS-застосунку CORS не потрібен):
# CORS_ORIGINS=http://localhost:3000

# ── Дослідницький API ────────────────────────────────────────────────────────
RESEARCH_ECHO_MAX_BYTES=5242880
# Ключ Anthropic для POST /api/research/llm. Без нього ендпоінт повертає 503.
ANTHROPIC_API_KEY=
# Моделі ЗАФІКСОВАНІ заради відтворюваності — не змінюйте посеред серії вимірювань.
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MODEL_LARGE=claude-sonnet-5-5
LLM_EFFORT=low
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# ── Демо-дані (scripts/seed_sandbox.py) ──────────────────────────────────────
# ЗГЕНЕРОВАНІ тестові облікові дані пісочниці — не справжні. Цим паролем
# можна увійти в будь-який згенерований акаунт (demo@… та userNNN@kopiyka.test).
SEED_DEMO_EMAIL=demo@kopiyka.test
SEED_DEMO_PASSWORD=kp-sandbox-VXFGSH_CIiRy

# Демо-нарахування віртуальних надходжень (POST /api/payouts/demo-accrual)
ALLOW_DEMO_PAYOUT_ACCRUAL=0

# Вхід через Apple: bundle id застосунку (aud у identity token)
APPLE_CLIENT_ID=com.eprisjournal.kopiyka
